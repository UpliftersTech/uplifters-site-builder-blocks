{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/block-on-background",
	"version": "1.0.1",
	"title": "Block On Background",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M0 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2H2a2 2 0 0 1-2-2zm5 10v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2v5a2 2 0 0 1-2 2z'></path></svg>",
	"description": "Wrap inner blocks in a container with a background image, color, or gradient, plus adjustable dimensions, padding, and a darkening overlay.",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"blockHeight": {
			"type": "number",
			"default": 400
		},
		"blockWidth": {
			"type": "number",
			"default": 1200
		},
		"paddingTop": {
			"type": "number",
			"default": 20
		},
		"paddingBottom": {
			"type": "number",
			"default": 20
		},
		"paddingLeft": {
			"type": "number",
			"default": 20
		},
		"paddingRight": {
			"type": "number",
			"default": 20
		},
		"bgImageId": {
			"type": "number",
			"default": 0
		},
		"bgImageUrl": {
			"type": "string",
			"default": ""
		},
		"overlayOpacity": {
			"type": "number",
			"default": 30
		},
		"bgColor": {
			"type": "string",
			"default": ""
		},
		"bgGradient": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": ["full", "wide"]
	}
}
