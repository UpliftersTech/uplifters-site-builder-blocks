{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/column-layout",
	"title": "Column Layout",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "smiley",
	"description": "Create a responsive multi-column layout with selectable and resizable columns.",
	"version": "1.0.0",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"keywords": [
		"columns",
		"layout",
		"section",
		"grid",
		"resize"
	],
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"sections": {
			"type": "number",
			"default": 0
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"columnWidths": {
			"type": "object",
			"default": {
				"desktop": [],
				"tablet": [],
				"mobile": []
			}
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	}
}
