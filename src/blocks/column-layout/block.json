{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/column-layout",
	"title": "Column Layout",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M0 3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm8.5-1v12H14a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1zm-1 0H2a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h5.5z'></path></svg>",
	"description": "Create a responsive multi-column layout with selectable and resizable columns.",
	"version": "1.0.1",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"keywords": [
		"columns",
		"layout",
		"section",
		"grid",
		"resize"
	],
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"sections": {
			"type": "number",
			"default": 0
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"columnWidths": {
			"type": "object",
			"default": {
				"desktop": [],
				"tablet": [],
				"mobile": []
			}
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	}
}
