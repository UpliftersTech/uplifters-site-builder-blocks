{
  "$schema": "https://schemas.wp.org/wp/6.7/block.json",
  "apiVersion": 3,
  "name": "uplifters-site-builder-blocks/copyright-component-rearrange",
  "version": "1.0.0",
  "title": "Copyright Notice",
  "category": "uplifters-site-builder-blocks-gene",
  "icon": "smiley",
  "description": "Display a customizable copyright line with automatic or fixed year options.",
  "textdomain": "uplifters-site-builder-blocks",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
