{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/footer-section",
	"title": "Footer Section",
    "version": "1.0.1",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 17 17' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M1 13h15v1h-15v-1zM4 15.993h9v-1h-9v1zM17 1v11h-17v-11h17zM16 2h-15v9h15v-9z'></path></svg>",
	"description": "A section container inside the Footer Layout block for arranging responsive footer columns.",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"align": {
			"type": "string",
			"default": "full"
		},
		"columnWidths": {
			"type": "object",
			"default": {
				"desktop": [25, 25, 25, 25],
				"tablet": [25, 25, 25, 25],
				"mobile": [25, 25, 25, 25]
			}
		},
		"verticalAlignment": {
			"type": "object",
			"default": {
				"desktop": "center",
				"tablet": "center",
				"mobile": "center"
			}
		},
		"responsiveBlockOrder": {
			"type": "object",
			"default": {
				"desktop": [],
				"tablet": [],
				"mobile": []
			}
		},
		"height": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"mobileStack": {
			"type": "boolean",
			"default": false
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		}
	},

	"supports": {
		"align": ["full"],
		"html": false,
		"inserter": false
	}
}
