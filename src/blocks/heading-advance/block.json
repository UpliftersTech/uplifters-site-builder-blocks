{
  "$schema": "https://schemas.wp.org/wp/6.7/block.json",
  "apiVersion": 3,
  "name": "uplifters-site-builder-blocks/heading-advance",
  "title": "Advance Heading",
  "category": "uplifters-site-builder-blocks-text",
  "icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 512 512' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M448 96v320h32a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16H320a16 16 0 0 1-16-16v-32a16 16 0 0 1 16-16h32V288H160v128h32a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16H32a16 16 0 0 1-16-16v-32a16 16 0 0 1 16-16h32V96H32a16 16 0 0 1-16-16V48a16 16 0 0 1 16-16h160a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16h-32v128h192V96h-32a16 16 0 0 1-16-16V48a16 16 0 0 1 16-16h160a16 16 0 0 1 16 16v32a16 16 0 0 1-16 16z'></path></svg>",
  "description": "Add a heading with responsive typography and styling controls.",
  "keywords": [ "heading", "title", "headline", "typography", "content" ],
  "version": "1.0.2",
  "textdomain": "uplifters-site-builder-blocks",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",

"example": {
    "viewportWidth": 700,
    "attributes": {
      "preview": true,
      "content": {
        "desktop": "Advance Heading",
        "tablet": "Advance Heading",
        "mobile": "Advance Heading"
      },
      "textType": { "desktop": "h2", "tablet": "h2", "mobile": "h2" },
      "textAlign": { "desktop": "center", "tablet": "center", "mobile": "center" }
    }
  },

  "attributes": {
    "preview": {
      "type": "boolean",
      "default": false
    },
    "content": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "textType": {
      "type": "object",
      "default": {
        "desktop": "h1",
        "tablet": "h1",
        "mobile": "h1"
      }
    },
    "fontFamily": {
      "type": "object",
      "default": {
        "desktop": "inherit",
        "tablet": "inherit",
        "mobile": "inherit"
      }
    },
    "textColor": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "backgroundColor": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "fontSize": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "lineHeight": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "fontWeight": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "textAlign": {
      "type": "object",
      "default": {
        "desktop": "left",
        "tablet": "left",
        "mobile": "left"
      }
    },
    "letterSpacing": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "wordSpacing": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "textTransform": {
      "type": "object",
      "default": {
        "desktop": "none",
        "tablet": "none",
        "mobile": "none"
      }
    },
    "padding": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "desktop": {},
        "tablet": {},
        "mobile": {}
      }
    }
  },
  "supports": {
    "anchor": true,
    "align": true
  }
}
