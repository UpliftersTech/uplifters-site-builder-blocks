{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/image-gallery",
	"version": "1.0.1",
	"title": "Image Gallery",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M6.502 7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3'></path><path d='M14 14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zM4 1a1 1 0 0 0-1 1v10l2.224-2.224a.5.5 0 0 1 .61-.075L8 11l2.157-3.02a.5.5 0 0 1 .76-.063L13 10V4.5h-2A1.5 1.5 0 0 1 9.5 3V1z'></path></svg>",
	"description": "Create a responsive gallery with clickable images and preview links.",
	"textdomain": "uplifters-site-builder-blocks",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},

	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",

	"keywords": [
		"image",
		"gallery",
		"lightbox",
		"zoom",
		"responsive"
	],

	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true
	},

	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"images": {
			"type": "array",
			"default": []
		},

		"selectedIndex": {
			"type": "number",
			"default": 0
		},

		"linkTo": {
			"type": "string",
			"default": "none"
		},

		"openInNewTab": {
			"type": "boolean",
			"default": false
		},

		"objectFit": {
			"type": "object",
			"default": {
				"desktop": "cover",
				"tablet": "cover",
				"mobile": "cover"
			}
		},

		"imagesPerRow": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},

		"imageHeight": {
			"type": "object",
			"default": {
				"desktop": "320px",
				"tablet": "280px",
				"mobile": "240px"
			}
		},

		"imageShadow": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},

		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},

		"padding": {
			"type": "object",
			"default": {
				"desktop": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"tablet": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"mobile": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				}
			}
		},

		"margin": {
			"type": "object",
			"default": {
				"desktop": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"tablet": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"mobile": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				}
			}
		}
	}
}
