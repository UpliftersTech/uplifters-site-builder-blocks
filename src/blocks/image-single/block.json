{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/image-single",
	"version": "1.0.0",
	"title": "Custom Image",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "smiley",
	"description": "Display a responsive image with caption, link, sizing, and styling options.",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"textdomain": "uplifters-site-builder-blocks",

	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",

	"keywords": [
		"image",
		"photo",
		"media",
		"responsive"
	],

	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true
	},

	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"alt": {
			"type": "string",
			"default": ""
		},
		"caption": {
			"type": "string",
			"default": ""
		},
		"captionFontFamily": {
			"type": "object",
			"default": {
				"desktop": "inherit",
				"tablet": "inherit",
				"mobile": "inherit"
			}
		},
		"sizeSlug": {
			"type": "string",
			"default": "full"
		},
		"objectFit": {
			"type": "object",
			"default": {
				"desktop": "cover",
				"tablet": "cover",
				"mobile": "cover"
			}
		},
		"height": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"linkTo": {
			"type": "string",
			"default": "none"
		},
		"customLink": {
			"type": "string",
			"default": ""
		},
		"openInNewTab": {
			"type": "boolean",
			"default": false
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"padding": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"boxShadow": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		}
	}
}
