{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/page-grid",
	"version": "1.0.1",
	"title": "Selected Pages Grid",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z'></path></svg>",
	"description": "Display selected site pages as a responsive grid of linked page titles.",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"textdomain": "uplifters-site-builder-blocks",

	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",

	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"perPage": {
			"type": "number",
			"default": 10
		},
		"itemsPerRow": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"position": {
			"type": "object",
			"default": {
				"desktop": "start",
				"tablet": "start",
				"mobile": "start"
			}
		},
		"selectedPageIds": {
			"type": "array",
			"default": []
		},

		"titlePadding": {
			"type": "object",
			"default": {
				"desktop": {
					"top": "3px",
					"right": "3px",
					"bottom": "3px",
					"left": "3px"
				},
				"tablet": {
					"top": "3px",
					"right": "3px",
					"bottom": "3px",
					"left": "3px"
				},
				"mobile": {
					"top": "3px",
					"right": "3px",
					"bottom": "3px",
					"left": "3px"
				}
			}
		},
		"titleBg": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"titleColor": {
			"type": "object",
			"default": {
				"desktop": "#0f172a",
				"tablet": "#0f172a",
				"mobile": "#0f172a"
			}
		},
		"titleFontSize": {
			"type": "object",
			"default": {
				"desktop": 13,
				"tablet": 11,
				"mobile": 14
			}
		},
		"titleFontFamily": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},

		"hoverBg": {
			"type": "object",
			"default": {
				"desktop": "#e2e8f0",
				"tablet": "#e2e8f0",
				"mobile": "#e2e8f0"
			}
		},
		"hoverTextColor": {
			"type": "object",
			"default": {
				"desktop": "#0f172a",
				"tablet": "#0f172a",
				"mobile": "#0f172a"
			}
		}
	},

	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	}
}
