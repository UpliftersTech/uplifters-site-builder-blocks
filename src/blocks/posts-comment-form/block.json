{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/posts-comment-form",
	"title": "Comment Form",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M2.678 11.894a1 1 0 0 1 .287.801 11 11 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8 8 0 0 0 8 14c3.996 0 7-2.807 7-6s-3.004-6-7-6-7 2.808-7 6c0 1.468.617 2.83 1.678 3.894m-.493 3.905a22 22 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a10 10 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9 9 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105'></path><path d='M4 5.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8m0 2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5'></path></svg>",
	"description": "Let visitors submit comments through a customizable post or page comment form.",
	"version": "1.0.1",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"titleText": {
			"type": "string",
			"default": "Leave a comment"
		},
		"buttonText": {
			"type": "string",
			"default": "Send Comment"
		},
		"placeholder": {
			"type": "string",
			"default": "Write your comment…"
		},
		"showNameEmail": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"nameLabel": {
			"type": "string",
			"default": "Name"
		},
		"emailLabel": {
			"type": "string",
			"default": "Email"
		},
		"commentLabel": {
			"type": "string",
			"default": "Comment"
		},
		"successText": {
			"type": "string",
			"default": "Thanks! Your comment has been submitted."
		},
		"errorText": {
			"type": "string",
			"default": "Could not submit comment. Please try again."
		},
		"requireNameEmail": {
			"type": "boolean",
			"default": true
		},
		"buttonBgColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"buttonHoverBgColor": {
			"type": "object",
			"default": {
				"desktop": "#0b1220",
				"tablet": "#0b1220",
				"mobile": "#0b1220"
			}
		},
		"buttonTextColor": {
			"type": "object",
			"default": {
				"desktop": "#ffffff",
				"tablet": "#ffffff",
				"mobile": "#ffffff"
			}
		},
		"buttonRadius": {
			"type": "object",
			"default": {
				"desktop": 12,
				"tablet": 12,
				"mobile": 12
			}
		},
		"buttonPaddingX": {
			"type": "object",
			"default": {
				"desktop": 16,
				"tablet": 15,
				"mobile": 14
			}
		},
		"buttonPaddingY": {
			"type": "object",
			"default": {
				"desktop": 10,
				"tablet": 10,
				"mobile": 9
			}
		},
		"buttonMarginTop": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"fontFamily": {
			"type": "object",
			"default": {
				"desktop": "inherit",
				"tablet": "inherit",
				"mobile": "inherit"
			}
		}
	},
	"supports": {
		"html": false
	}
}
