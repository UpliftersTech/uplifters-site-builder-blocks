{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/posts-list",
	"title": "Post List",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z'></path><path d='M7 5.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0M7 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0'></path></svg>",
	"description": "Display WordPress posts in customizable list, grid, or compact layouts.",
	"version": "1.0.1",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"layoutType": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"perPage": {
			"type": "number",
			"default": 6
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"titleColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"titleFontFamily": {
			"type": "object",
			"default": {
				"desktop": "inherit",
				"tablet": "inherit",
				"mobile": "inherit"
			}
		},
		"linkTitle": {
			"type": "boolean",
			"default": false
		},
		"showImage": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showDate": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showExcerpt": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showReadMore": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"dateFontSize": {
			"type": "object",
			"default": {
				"desktop": 14,
				"tablet": 13,
				"mobile": 12
			}
		},
		"excerptMaxChars": {
			"type": "object",
			"default": {
				"desktop": 40,
				"tablet": 36,
				"mobile": 30
			}
		},
		"readMoreBgColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"readMoreFontSize": {
			"type": "object",
			"default": {
				"desktop": 14,
				"tablet": 13,
				"mobile": 12
			}
		}
	},
	"supports": {
		"html": false
	}
}
