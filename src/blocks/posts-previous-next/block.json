{
  "$schema": "https://schemas.wp.org/wp/6.7/block.json",
  "apiVersion": 3,
  "name": "uplifters-site-builder-blocks/posts-previous-next",
  "version": "1.0.0",
  "title": "Post Navigation",
  "category": "uplifters-site-builder-blocks-gene",
  "icon": "smiley",
  "description": "Add previous and next post links to a single-post template.",
  "textdomain": "uplifters-site-builder-blocks",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
  "keywords": ["previous", "next", "post", "posts", "navigation"],
  "attributes": {
    "preview": { "type": "boolean", "default": false },
    "showPrevious": { "type": "object", "default": { "desktop": true, "tablet": true, "mobile": true } },
    "showNext": { "type": "object", "default": { "desktop": true, "tablet": true, "mobile": true } },
    "previousLabel": { "type": "object", "default": { "desktop": "Previous Post", "tablet": "Previous Post", "mobile": "Previous Post" } },
    "nextLabel": { "type": "object", "default": { "desktop": "Next Post", "tablet": "Next Post", "mobile": "Next Post" } },
    "previousArrow": { "type": "object", "default": { "desktop": "←", "tablet": "←", "mobile": "←" } },
    "nextArrow": { "type": "object", "default": { "desktop": "→", "tablet": "→", "mobile": "→" } },
    "openInSameTab": { "type": "boolean", "default": true },
    "buttonRadius": { "type": "object", "default": { "desktop": 999, "tablet": 999, "mobile": 999 } },
    "buttonPaddingY": { "type": "object", "default": { "desktop": 12, "tablet": 12, "mobile": 12 } },
    "buttonPaddingX": { "type": "object", "default": { "desktop": 18, "tablet": 16, "mobile": 14 } },
    "gap": { "type": "object", "default": { "desktop": 12, "tablet": 12, "mobile": 10 } },
    "fontSize": { "type": "object", "default": { "desktop": 15, "tablet": 15, "mobile": 14 } },
    "fontFamily": { "type": "object", "default": { "desktop": "inherit", "tablet": "inherit", "mobile": "inherit" } },
    "fontWeight": { "type": "object", "default": { "desktop": 600, "tablet": 600, "mobile": 600 } },
    "textColor": { "type": "object", "default": { "desktop": "#111827", "tablet": "#111827", "mobile": "#111827" } },
    "backgroundColor": { "type": "object", "default": { "desktop": "#ffffff", "tablet": "#ffffff", "mobile": "#ffffff" } },
    "borderColor": { "type": "object", "default": { "desktop": "#d1d5db", "tablet": "#d1d5db", "mobile": "#d1d5db" } },
    "hoverTextColor": { "type": "object", "default": { "desktop": "#ffffff", "tablet": "#ffffff", "mobile": "#ffffff" } },
    "hoverBackgroundColor": { "type": "object", "default": { "desktop": "#111827", "tablet": "#111827", "mobile": "#111827" } },
    "hoverBorderColor": { "type": "object", "default": { "desktop": "#111827", "tablet": "#111827", "mobile": "#111827" } }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  }
}
