{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/posts-related",
	"title": "Related Posts",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 512 512' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M326.612 185.391c59.747 59.809 58.927 155.698.36 214.59-.11.12-.24.25-.36.37l-67.2 67.2c-59.27 59.27-155.699 59.262-214.96 0-59.27-59.26-59.27-155.7 0-214.96l37.106-37.106c9.84-9.84 26.786-3.3 27.294 10.606.648 17.722 3.826 35.527 9.69 52.721 1.986 5.822.567 12.262-3.783 16.612l-13.087 13.087c-28.026 28.026-28.905 73.66-1.155 101.96 28.024 28.579 74.086 28.749 102.325.51l67.2-67.19c28.191-28.191 28.073-73.757 0-101.83-3.701-3.694-7.429-6.564-10.341-8.569a16.037 16.037 0 0 1-6.947-12.606c-.396-10.567 3.348-21.456 11.698-29.806l21.054-21.055c5.521-5.521 14.182-6.199 20.584-1.731a152.482 152.482 0 0 1 20.522 17.197zM467.547 44.449c-59.261-59.262-155.69-59.27-214.96 0l-67.2 67.2c-.12.12-.25.25-.36.37-58.566 58.892-59.387 154.781.36 214.59a152.454 152.454 0 0 0 20.521 17.196c6.402 4.468 15.064 3.789 20.584-1.731l21.054-21.055c8.35-8.35 12.094-19.239 11.698-29.806a16.037 16.037 0 0 0-6.947-12.606c-2.912-2.005-6.64-4.875-10.341-8.569-28.073-28.073-28.191-73.639 0-101.83l67.2-67.19c28.239-28.239 74.3-28.069 102.325.51 27.75 28.3 26.872 73.934-1.155 101.96l-13.087 13.087c-4.35 4.35-5.769 10.79-3.783 16.612 5.864 17.194 9.042 34.999 9.69 52.721.509 13.906 17.454 20.446 27.294 10.606l37.106-37.106c59.271-59.259 59.271-155.699.001-214.959z'></path></svg>",
	"description": "Automatically display related posts based on shared categories or tags.",
	"version": "1.0.1",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"perPage": {
			"type": "number",
			"default": 6
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"relateBy": {
			"type": "string",
			"default": "categories"
		},
		"fallbackToRecent": {
			"type": "boolean",
			"default": true
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 16,
				"tablet": 14,
				"mobile": 12
			}
		},
		"showFeaturedImage": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"imageHeight": {
			"type": "object",
			"default": {
				"desktop": 180,
				"tablet": 170,
				"mobile": 200
			}
		},
		"showExcerpt": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"excerptLength": {
			"type": "object",
			"default": {
				"desktop": 20,
				"tablet": 18,
				"mobile": 15
			}
		},
		"showMeta": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showDate": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showAuthor": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"titleColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"titleFontFamily": {
			"type": "object",
			"default": {
				"desktop": "inherit",
				"tablet": "inherit",
				"mobile": "inherit"
			}
		},
		"metaColor": {
			"type": "object",
			"default": {
				"desktop": "#6b7280",
				"tablet": "#6b7280",
				"mobile": "#6b7280"
			}
		},
		"excerptColor": {
			"type": "object",
			"default": {
				"desktop": "#374151",
				"tablet": "#374151",
				"mobile": "#374151"
			}
		},
		"cardBg": {
			"type": "object",
			"default": {
				"desktop": "#ffffff",
				"tablet": "#ffffff",
				"mobile": "#ffffff"
			}
		},
		"cardBorder": {
			"type": "object",
			"default": {
				"desktop": "#e5e7eb",
				"tablet": "#e5e7eb",
				"mobile": "#e5e7eb"
			}
		},
		"emptyText": {
			"type": "string",
			"default": "No related posts found."
		}
	},
	"supports": {
		"html": false
	}
}
