{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/posts-related",
	"title": "Related Posts",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "smiley",
	"description": "Automatically display related posts based on shared categories or tags.",
	"version": "1.0.0",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"perPage": {
			"type": "number",
			"default": 6
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"relateBy": {
			"type": "string",
			"default": "categories"
		},
		"fallbackToRecent": {
			"type": "boolean",
			"default": true
		},
		"columns": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 16,
				"tablet": 14,
				"mobile": 12
			}
		},
		"showFeaturedImage": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"imageHeight": {
			"type": "object",
			"default": {
				"desktop": 180,
				"tablet": 170,
				"mobile": 200
			}
		},
		"showExcerpt": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"excerptLength": {
			"type": "object",
			"default": {
				"desktop": 20,
				"tablet": 18,
				"mobile": 15
			}
		},
		"showMeta": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showDate": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"showAuthor": {
			"type": "object",
			"default": {
				"desktop": true,
				"tablet": true,
				"mobile": true
			}
		},
		"titleColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"titleFontFamily": {
			"type": "object",
			"default": {
				"desktop": "inherit",
				"tablet": "inherit",
				"mobile": "inherit"
			}
		},
		"metaColor": {
			"type": "object",
			"default": {
				"desktop": "#6b7280",
				"tablet": "#6b7280",
				"mobile": "#6b7280"
			}
		},
		"excerptColor": {
			"type": "object",
			"default": {
				"desktop": "#374151",
				"tablet": "#374151",
				"mobile": "#374151"
			}
		},
		"cardBg": {
			"type": "object",
			"default": {
				"desktop": "#ffffff",
				"tablet": "#ffffff",
				"mobile": "#ffffff"
			}
		},
		"cardBorder": {
			"type": "object",
			"default": {
				"desktop": "#e5e7eb",
				"tablet": "#e5e7eb",
				"mobile": "#e5e7eb"
			}
		},
		"emptyText": {
			"type": "string",
			"default": "No related posts found."
		}
	},
	"supports": {
		"html": false
	}
}
