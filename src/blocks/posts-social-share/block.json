{
  "$schema": "https://schemas.wp.org/wp/6.7/block.json",
  "apiVersion": 3,
  "name": "uplifters-site-builder-blocks/posts-social-share",
  "title": "Social Share Buttons",
  "category": "uplifters-site-builder-blocks-gene",
  "icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3'></path></svg>",
  "description": "Let visitors share the current post through social networks, email, or a copied link.",
  "version": "1.0.1",
  "textdomain": "uplifters-site-builder-blocks",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
  "attributes": {
    "preview": {
      "type": "boolean",
      "default": false
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true
    },
    "variant": {
      "type": "object",
      "default": {
        "desktop": "solid",
        "tablet":  "solid",
        "mobile":  "solid"
      }
    },
    "facebook": {
      "type": "boolean",
      "default": true
    },
    "x": {
      "type": "boolean",
      "default": true
    },
    "whatsapp": {
      "type": "boolean",
      "default": true
    },
    "email": {
      "type": "boolean",
      "default": true
    },
    "reddit": {
      "type": "boolean",
      "default": true
    },
    "copyLink": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "object",
      "default": {
        "desktop": "start",
        "tablet":  "start",
        "mobile":  "center"
      }
    },
    "iconSize": {
      "type": "object",
      "default": {
        "desktop": 50,
        "tablet":  44,
        "mobile":  38
      }
    },
    "iconGap": {
      "type": "object",
      "default": {
        "desktop": 8,
        "tablet":  8,
        "mobile":  6
      }
    },
    "boxPadding": {
      "type": "object",
      "default": {
        "desktop": 16,
        "tablet":  14,
        "mobile":  12
      }
    },
    "boxMargin": {
      "type": "object",
      "default": {
        "desktop": 0,
        "tablet":  0,
        "mobile":  0
      }
    }
  },
  "supports": {
    "html": false
  }
}
