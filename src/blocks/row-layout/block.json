
{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/row-layout",
	"version": "1.0.2",
	"title": "Row Layout",
	"category": "uplifters-site-builder-blocks-wrapper",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 448 512' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M413.1 222.5l-91.9-94.9c-9.7-9.9-25.4-9.9-35 0l-91.9 94.9c-14.9 15.4-4.2 41.5 17.5 41.5H277v96h-66.3c-21.7 0-32.4 26.1-17.5 41.5l91.9 94.9c9.7 9.9 25.4 9.9 35 0l91.9-94.9c14.9-15.4 4.2-41.5-17.5-41.5H331v-96h66.3c21.7 0 32.4-26.1 17.8-41.5z'></path></svg>",
	"description": "A vertically stacked row layout with an inline block appender and add/remove controls for each row.",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"padding": {
			"type": "object",
			"default": {
				"desktop": "24px",
				"tablet": "20px",
				"mobile": "16px"
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": "0px",
				"tablet": "0px",
				"mobile": "0px"
			}
		},
		"borderRadius": {
			"type": "object",
			"default": {
				"desktop": "0px",
				"tablet": "0px",
				"mobile": "0px"
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"dividerGap": {
			"type": "object",
			"default": {
				"desktop": "0px",
				"tablet": "0px",
				"mobile": "0px"
			}
		}
	},
	"supports": {
		"html": false
	}
