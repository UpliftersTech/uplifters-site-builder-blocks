{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/scroll-to-top",
	"version": "1.0.1",
	"title": "Scroll To Top",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 448 512' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M34.9 289.5l-22.2-22.2c-9.4-9.4-9.4-24.6 0-33.9L207 39c9.4-9.4 24.6-9.4 33.9 0l194.3 194.3c9.4 9.4 9.4 24.6 0 33.9L413 289.4c-9.5 9.5-25 9.3-34.3-.4L264 168.6V456c0 13.3-10.7 24-24 24h-32c-13.3 0-24-10.7-24-24V168.6L69.2 289.1c-9.3 9.8-24.8 10-34.3.4z'></path></svg>",
	"description": "A floating button that scrolls the page back to the top.",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"placement": {
			"type": "string",
			"default": "bottom-right"
		},
		"hideAtStart": {
			"type": "boolean",
			"default": true
		},
		"showAfter": {
			"type": "number",
			"default": 300
		},
		"arrowStyle": {
			"type": "string",
			"default": "arrow"
		},
		"arrowColor": {
			"type": "object",
			"default": {
				"desktop": "#ffffff",
				"tablet": "#ffffff",
				"mobile": "#ffffff"
			}
		},
		"arrowSize": {
			"type": "object",
			"default": {
				"desktop": "22px",
				"tablet": "20px",
				"mobile": "18px"
			}
		},
		"size": {
			"type": "object",
			"default": {
				"desktop": "64px",
				"tablet": "56px",
				"mobile": "48px"
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "#2563eb",
				"tablet": "#2563eb",
				"mobile": "#2563eb"
			}
		},
		"outlineWidth": {
			"type": "object",
			"default": {
				"desktop": "2px",
				"tablet": "2px",
				"mobile": "2px"
			}
		},
		"outlineColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"hoverBackgroundColor": {
			"type": "object",
			"default": {
				"desktop": "#1d4ed8",
				"tablet": "#1d4ed8",
				"mobile": "#1d4ed8"
			}
		},
		"hoverArrowColor": {
			"type": "object",
			"default": {
				"desktop": "#ffffff",
				"tablet": "#ffffff",
				"mobile": "#ffffff"
			}
		},
		"hoverOutlineColor": {
			"type": "object",
			"default": {
				"desktop": "#111827",
				"tablet": "#111827",
				"mobile": "#111827"
			}
		},
		"offsetX": {
			"type": "object",
			"default": {
				"desktop": "32px",
				"tablet": "24px",
				"mobile": "16px"
			}
		},
		"offsetY": {
			"type": "object",
			"default": {
				"desktop": "32px",
				"tablet": "24px",
				"mobile": "16px"
			}
		}
	},
	"supports": {
		"html": false,
		"multiple": false
	}
}
