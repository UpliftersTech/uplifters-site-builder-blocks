{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/site-logo",
	"version": "1.0.1",
	"title": "Site Logo",
	"category": "uplifters-site-builder-blocks-gene",
