{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/space-around",
	"title": "Spacer All-Around",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M8.354 14.854a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L7.5 13.293V2.707L6.354 3.854a.5.5 0 1 1-.708-.708l2-2a.5.5 0 0 1 .708 0l2 2a.5.5 0 0 1-.708.708L8.5 2.707v10.586l1.146-1.147a.5.5 0 0 1 .708.708z'></path></svg>",
	"description": "Adds responsive vertical and horizontal space with optional background color.",
	"version": "1.0.1",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"spacingDirection": {
			"type": "string",
			"default": "vertical"
		},
		"height": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"width": {
			"type": "object",
			"default": {
				"desktop": 0,
				"tablet": 0,
				"mobile": 0
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "transparent",
				"tablet": "transparent",
				"mobile": "transparent"
			}
		},
		"labelColor": {
			"type": "object",
			"default": {
				"desktop": "#64748b",
				"tablet": "#64748b",
				"mobile": "#64748b"
			}
		}
	},


	"supports": {
		"html": false,
		"anchor": true,
		"align": true
	},
 
	"example": {
		"attributes": {
			"preview": true,
			"height": {
				"desktop": 80,
				"tablet": 60,
				"mobile": 40
			},
			"width": {
				"desktop": 200,
				"tablet": 160,
				"mobile": 120
			}
		}
	}
}