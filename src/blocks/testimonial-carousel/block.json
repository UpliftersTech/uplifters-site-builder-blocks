{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/testimonial-carousel",
	"version": "1.0.1",
	"title": "Testimonial Carousel",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4m4-2.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5M9 8a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4A.5.5 0 0 1 9 8m1 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5'></path><path d='M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H8.96q.04-.245.04-.5C9 10.567 7.21 9 5 9c-2.086 0-3.8 1.398-3.984 3.181A1 1 0 0 1 1 12z'></path></svg>",
	"description": "Display customer testimonials in a responsive carousel with autoplay and navigation.",
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"items": {
			"type": "array",
			"default": [
				{
					"imageId": 0,
					"imageUrl": "",
					"imageAlt": "",
					"name": "",
					"designation": "",
					"text": ""
				}
			]
		},
		"displayCount": {
			"type": "object",
			"default": {
				"desktop": 1,
				"tablet": 1,
				"mobile": 1
			}
		},
		"imageWidth": {
			"type": "object",
			"default": {
				"desktop": 64,
				"tablet": 64,
				"mobile": 56
			}
		},
		"imageHeight": {
			"type": "object",
			"default": {
				"desktop": 64,
				"tablet": 64,
				"mobile": 56
			}
		},
		"gap": {
			"type": "object",
			"default": {
				"desktop": 16,
				"tablet": 14,
				"mobile": 12
			}
		},
		"autoplay": {
			"type": "boolean",
			"default": true
		},
		"pauseOnHover": {
			"type": "boolean",
			"default": true
		},
		"interval": {
			"type": "number",
			"default": 3500
		},
		"speed": {
			"type": "number",
			"default": 650
		},
		"showArrows": {
			"type": "boolean",
			"default": true
		},
		"showDots": {
			"type": "boolean",
			"default": true
		},
		"perView": {
			"type": "object",
			"default": {
				"desktop": 3,
				"tablet": 2,
				"mobile": 1
			}
		},
		"minCardWidth": {
			"type": "object",
			"default": {
				"desktop": 280,
				"tablet": 240,
				"mobile": 180
			}
		},
		"fontFamily": {
			"type": "object",
			"default": {
				"desktop": "default",
				"tablet": "default",
				"mobile": "default"
			}
		},
		"nameFontFamily": {
			"type": "object",
			"default": {
				"desktop": "default",
				"tablet": "default",
				"mobile": "default"
			}
		},
		"designationFontFamily": {
			"type": "object",
			"default": {
				"desktop": "default",
				"tablet": "default",
				"mobile": "default"
			}
		},
		"textColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"backgroundColor": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"fontSize": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"lineHeight": {
			"type": "object",
			"default": {
				"desktop": "",
				"tablet": "",
				"mobile": ""
			}
		},
		"isItalic": {
			"type": "object",
			"default": {
				"desktop": false,
				"tablet": false,
				"mobile": false
			}
		},
		"fontWeight": {
			"type": "object",
			"default": {
				"desktop": "400",
				"tablet": "400",
				"mobile": "400"
			}
		},
		"padding": {
			"type": "object",
			"default": {
				"desktop": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"tablet": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"mobile": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				}
			}
		},
		"margin": {
			"type": "object",
			"default": {
				"desktop": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"tablet": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				},
				"mobile": {
					"top": "",
					"right": "",
					"bottom": "",
					"left": ""
				}
			}
		}
	},
	"supports": {
		"anchor": true,
		"align": true
	}
}
