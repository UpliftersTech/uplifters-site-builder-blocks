{
  "$schema": "https://schemas.wp.org/wp/6.7/block.json",
  "apiVersion": 3,
  "name": "uplifters-site-builder-blocks/video-embed",
  "version": "1.0.2",
  "title": "Video Embed",
  "category": "uplifters-site-builder-blocks-media",
  "icon": "<svg stroke='#5BC3F5' fill='#5BC3F5' stroke-width='0' viewBox='0 0 16 16' height='20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M10.804 8 5 4.633v6.734zm.792-.696a.802.802 0 0 1 0 1.392l-6.363 3.692C4.713 12.69 4 12.345 4 11.692V4.308c0-.653.713-.998 1.233-.696z'></path></svg>",
  "description": "A single embedded video (YouTube, Vimeo, etc.) shown at the full width of its container.",
  "textdomain": "uplifters-site-builder-blocks",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
	"example": {
		"attributes": { "preview": true },
		"viewportWidth": 700
	},
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true
  },
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
    "url": {
      "type": "string",
      "default": ""
    },
    "embedHtml": {
      "type": "string",
      "default": ""
    },
    "providerName": {
      "type": "string",
      "default": ""
    },
    "errorMessage": {
      "type": "string",
      "default": ""
    },
    "thumbnailUrl": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "default": ""
    },
    "youtubeId": {
      "type": "string",
      "default": ""
    },
    "padding": {
      "type": "object",
      "default": {
        "desktop": { "top": "", "right": "", "bottom": "", "left": "" },
        "tablet": { "top": "", "right": "", "bottom": "", "left": "" },
        "mobile": { "top": "", "right": "", "bottom": "", "left": "" }
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "desktop": { "top": "", "right": "", "bottom": "", "left": "" },
        "tablet": { "top": "", "right": "", "bottom": "", "left": "" },
        "mobile": { "top": "", "right": "", "bottom": "", "left": "" }
      }
    },
    "borderRadius": {
      "type": "object",
      "default": {
        "desktop": "",
        "tablet": "",
        "mobile": ""
      }
    },
    "items": {
      "type": "array",
      "default": []
    }
  }
}
