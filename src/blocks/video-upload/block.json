{
	"$schema": "https://schemas.wp.org/wp/6.7/block.json",
	"apiVersion": 3,
	"name": "uplifters-site-builder-blocks/video-upload",
	"version": "1.0.0",
	"title": "Upload Video",
	"category": "uplifters-site-builder-blocks-gene",
	"icon": "smiley",
	"description": "Multiple videos grid with per-item sizing and spacing.",
	"example": { "attributes": { "preview": true }, "viewportWidth": 700 },
	"textdomain": "uplifters-site-builder-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"preview": {
			"type": "boolean",
			"default": false
		},
		"videos": {
			"type": "array",
			"default": []
		},
		"rows": {
			"type": "object",
			"default": {
				"desktop": 1,
				"tablet": 1,
				"mobile": 1
			}
		}
	},
	"supports": {
		"html": false
	}
}